#!/usr/bin/env bash
# deploy: pull the BFEP website repo and sync custom modules into the Drupal container
#
# Usage:  bfep deploy [branch]        deploy a branch (default: main)
#         DRY_RUN=1 bfep deploy       show what would change, touch nothing
#         NO_UPDB=1 bfep deploy       skip "drush updb" (still clears caches)
#
# This is the former /usr/local/bin/bfep-deploy, unchanged apart from
# comments. "bfep-deploy" still works after install.sh.
set -euo pipefail
# Files the web server reads must be world-readable. "bfep update" runs this
# under umask 077, which made newly added module files unreadable (0600).
umask 022
# shellcheck source=../lib/cli.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/cli.sh"

# Options people try, and the setting that does it.
SETTINGS=("--dry-run|DRY_RUN=1 bfep deploy" "--no-updb|NO_UPDB=1 bfep deploy" "--help|bfep help deploy")
case "${1:-}" in
  -h | --help | help) show_help; exit 0 ;;
  -*) usage_error deploy "unknown option '$1'" "${SETTINGS[@]}" ;;
  *=*) usage_error deploy "settings go before the command, not after it: '$1'" "${SETTINGS[@]}" ;;
esac
[[ $# -le 1 ]] || usage_error deploy "takes one branch, got: $*"

BRANCH="${1:-main}"
REPO="${REPO:-/opt/docker/drupal/repo}"
MODULES_DEST="${MODULES_DEST:-/opt/docker/drupal/modules/custom}"
THEMES_DEST="${THEMES_DEST:-/opt/docker/drupal/themes/custom}"
CONTAINER="${CONTAINER:-drupal}"
DRY_RUN="${DRY_RUN:-0}"
NO_UPDB="${NO_UPDB:-0}"

# shellcheck disable=SC2054  # the commas are rsync's --chmod syntax
RSYNC_OPTS=(-rltD --delete --human-readable --itemize-changes
  --chmod=D755,F644
  --exclude='.DS_Store' --exclude='.git*' --exclude='.idea')
[[ "$DRY_RUN" == "1" ]] && RSYNC_OPTS+=(--dry-run)

say() { printf '\n==> %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

# Only one deploy at a time.
exec 9>"${SITE_DEPLOY_LOCK:-/var/lock/bfep-deploy.lock}"
flock -n 9 || die "another bfep-deploy is already running"

[[ -d "$REPO/.git" ]] || die "no git checkout at $REPO"
[[ -d "$MODULES_DEST" ]] || die "modules destination $MODULES_DEST does not exist"
docker inspect "$CONTAINER" >/dev/null 2>&1 || die "container '$CONTAINER' not found"

cd "$REPO"
git diff --quiet && git diff --cached --quiet \
  || die "uncommitted changes in $REPO; refusing to deploy over them"

say "Fetching origin/$BRANCH"
before="$(git rev-parse --short HEAD)"
git fetch --prune origin "$BRANCH"
git checkout -q "$BRANCH" 2>/dev/null || git checkout -q -b "$BRANCH" "origin/$BRANCH"
git merge --ff-only "origin/$BRANCH"
after="$(git rev-parse --short HEAD)"
if [[ "$before" == "$after" ]]; then
  echo "Already at $after ($(git log -1 --format=%s))"
else
  git log --oneline "$before..$after"
fi

say "Syncing modules -> $MODULES_DEST"
# Sync each module separately so modules that are not in the repo are never deleted.
for src in "$REPO"/drupal/modules/custom/*/; do
  name="$(basename "$src")"
  mkdir -p "$MODULES_DEST/$name"
  echo "-- $name"
  rsync "${RSYNC_OPTS[@]}" "$src" "$MODULES_DEST/$name/"
done

if [[ -d "$REPO/drupal/themes/custom" ]]; then
  if [[ -d "$THEMES_DEST" ]]; then
    say "Syncing themes -> $THEMES_DEST"
    for src in "$REPO"/drupal/themes/custom/*/; do
      name="$(basename "$src")"
      mkdir -p "$THEMES_DEST/$name"
      echo "-- $name"
      rsync "${RSYNC_OPTS[@]}" "$src" "$THEMES_DEST/$name/"
    done
  else
    echo
    echo "NOTE: $THEMES_DEST does not exist, so themes were NOT synced."
    echo "      Set THEMES_DEST to the host folder mounted at /opt/drupal/web/themes/custom."
  fi
fi

if [[ "$DRY_RUN" == "1" ]]; then
  say "Dry run complete; nothing changed and Drupal was not touched"
  exit 0
fi

DRUSH="$(docker exec "$CONTAINER" sh -c 'ls /opt/drupal/vendor/bin/drush 2>/dev/null || command -v drush' || true)"
if [[ -z "$DRUSH" ]]; then
  echo
  echo "WARNING: drush not found in '$CONTAINER'; files are synced but caches were NOT cleared."
  echo "         Clear caches at /admin/config/development/performance."
  exit 0
fi

drush() { docker exec -u www-data -w /opt/drupal "$CONTAINER" "$DRUSH" "$@"; }

# drush updb puts the site in maintenance mode while updates run, and only
# turns it off after the last one succeeds. If an update fails or the deploy
# is interrupted (Ctrl-C, a dropped SSH session), put maintenance mode back
# the way it was, so the site isn't left on the maintenance page unattended.
restore_maintenance() {
  local rc=$?
  [[ $rc -eq 0 ]] && return
  set +e
  trap - EXIT HUP INT TERM
  echo
  echo "Database updates did not finish (exit $rc)."
  if drush state:set system.maintenance_mode 0 --input-format=integer && drush cr >/dev/null; then
    echo "Maintenance mode is off again (drush turns it on while updates run)."
  else
    echo "Could not turn maintenance mode off. Turn it off with:"
    echo "  docker exec -u www-data -w /opt/drupal $CONTAINER $DRUSH state:set system.maintenance_mode 0 --input-format=integer"
  fi
  echo "See what is still pending with: docker exec -u www-data -w /opt/drupal $CONTAINER $DRUSH updb:status"
} >&2

if [[ "$NO_UPDB" != "1" ]]; then
  say "Running database updates"
  maint_was="$(drush state:get system.maintenance_mode 2>/dev/null || true)"
  if [[ "$maint_was" != "1" && "$maint_was" != "true" ]]; then
    trap restore_maintenance EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
  fi
  drush updb -y
  trap - EXIT HUP INT TERM
fi
say "Clearing caches"
drush cr

say "Deployed $after: $(git log -1 --format=%s)"
