#!/usr/bin/env bash
# sync: run, check, deploy or roll back the fundraiser figure sync
#
# Usage:  bfep sync [--apply] [--limit N] [...]  run the sync now (a dry run unless --apply)
#         bfep sync status                       deployed version, timer, last run
#         bfep sync log [N] [--since WHEN|--all]  the last N lines of its log (default 50)
#                                                from the last 24 hours; WHEN is e.g. 3d,
#                                                12h or 2026-10-01; --all searches it all
#         bfep sync test                         run the test suite on the live copy
#         bfep sync deploy [ref]                 deploy a branch or tag from GitHub (default: main)
#         DRY_RUN=1 bfep sync deploy             show what would change, touch nothing
#         bfep sync rollback                     swap back to the version before the last deploy
#
# A deploy fetches the bfep-sync repo into $REPO, runs its tests, copies it
# over $LIVE (keeping the old copy in $PREV and any *-wip folders), and
# refuses while a sync run is in progress. The systemd timer keeps running
# $LIVE/sync.py, so a deploy needs no other change.
set -euo pipefail

LIVE="${LIVE:-/opt/bfep-sync}"
PREV="${PREV:-$LIVE.prev}"
REPO="${REPO:-/opt/bfep-sync-src}"
ENV_FILE="${ENV_FILE:-/etc/bfep-sync.env}"
RUN_LOCK="${RUN_LOCK:-/run/bfep-sync.lock}"
DEPLOY_LOCK="${DEPLOY_LOCK:-/var/lock/bfep-sync-deploy.lock}"
UNIT="${UNIT:-bfep-sync}"
PY="${PYTHON:-python3}"
DRY_RUN="${DRY_RUN:-0}"

RSYNC_OPTS=(-rlptD --delete --human-readable --itemize-changes --chmod=go-w
  --exclude='.git*' --exclude='__pycache__/' --exclude='*-wip/'
  --exclude='/.deployed' --exclude='/.venv/')

say() { printf '\n==> %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
# shellcheck source=../lib/cli.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/cli.sh"

# For typo hints. The options are bfep_sync's own (python3 sync.py --help).
COMMAND_HINTS=()
for c in status log test deploy rollback help --apply --limit --after --provider --retries --help; do
  COMMAND_HINTS+=("$c|bfep sync $c")
done

version() { cat "$1/.deployed" 2>/dev/null || echo "unknown (installed by hand)"; }

load_env() {
  [[ -r "$ENV_FILE" ]] || die "cannot read $ENV_FILE"
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
}

# Holds the lock the systemd unit takes, so code is never swapped mid-run.
hold_run_lock() {
  exec 8>"$RUN_LOCK"
  flock -n 8 || die "a sync run is in progress; try again when it finishes (bfep sync status)"
}

run() {
  load_env
  cd "$LIVE"
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--apply" ]]; then
      # Same lock as the timer, so a manual run and a timer run never overlap.
      hold_run_lock
      break
    fi
  done
  BFEP_SYNC_PROG="bfep sync" exec "$PY" sync.py "$@"
}

status() {
  echo "Deployed:  $(version "$LIVE")"
  [[ -d "$PREV" ]] && echo "Previous:  $(version "$PREV")  (bfep sync rollback)"
  echo
  systemctl list-timers "$UNIT.timer" --all --no-pager | head -2
  echo
  systemctl show "$UNIT.service" -p ActiveState -p Result -p ExecMainExitTimestamp -p ExecMainStatus --no-pager
  echo
  echo "Last log lines:"
  journalctl -u "$UNIT" -n 12 --no-pager -o cat
}

deploy() {
  case "${1:-}" in
    -h | --help) show_help; return 0 ;;
    -*) usage_error sync "unknown option for deploy: '$1'" "--dry-run|DRY_RUN=1 bfep sync deploy" ;;
    *=*) usage_error sync "settings go before the command, not after it: '$1'" "--dry-run|DRY_RUN=1 bfep sync deploy" ;;
  esac
  [[ $# -le 1 ]] || usage_error sync "deploy takes one branch or tag, got: $*"
  local ref="${1:-main}" before after
  exec 9>"$DEPLOY_LOCK"
  flock -n 9 || die "another bfep sync deploy is already running"

  [[ -d "$REPO/.git" ]] || die "no git checkout at $REPO (see install.sh)"
  cd "$REPO"
  if ! git diff --quiet || ! git diff --cached --quiet; then
    die "uncommitted changes in $REPO; refusing to deploy over them"
  fi

  say "Fetching $ref"
  before="$(git rev-parse --short HEAD)"
  git fetch --prune --tags origin
  if git show-ref -q --verify "refs/remotes/origin/$ref"; then
    git checkout -q "$ref" 2>/dev/null || git checkout -q -b "$ref" "origin/$ref"
    git merge -q --ff-only "origin/$ref"
  else
    git checkout -q --detach "$ref" || die "no branch, tag or commit called '$ref'"
  fi
  after="$(git rev-parse --short HEAD)"
  if [[ "$before" == "$after" ]]; then
    echo "Already at $after ($(git log -1 --format=%s))"
  else
    git log --oneline "$before..$after"
  fi

  say "Running tests"
  local out
  if ! out="$("$PY" -m unittest discover -s tests 2>&1)"; then
    printf '%s\n' "$out" | tail -30
    die "tests failed; nothing deployed"
  fi
  printf '%s\n' "$out" | tail -1

  say "Changes to $LIVE"
  if [[ "$DRY_RUN" == "1" ]]; then
    rsync "${RSYNC_OPTS[@]}" --dry-run "$REPO/" "$LIVE/"
    say "Dry run complete; $LIVE was not touched"
    return 0
  fi

  hold_run_lock
  if [[ -d "$LIVE" ]]; then
    rsync -a --delete "$LIVE/" "$PREV/"
  fi
  mkdir -p "$LIVE"
  rsync "${RSYNC_OPTS[@]}" "$REPO/" "$LIVE/"
  echo "$after $(git log -1 --format='%s') (deployed $(date '+%Y-%m-%d %H:%M'))" >"$LIVE/.deployed"

  say "Checking the deployed copy"
  if ! (cd "$LIVE" && "$PY" sync.py --help >/dev/null); then
    swap
    die "the deployed copy would not start, so the previous version was put back"
  fi
  say "Deployed $(version "$LIVE")"
}

# Exchanges $LIVE and $PREV, so a second rollback undoes the first.
swap() {
  local tmp="$LIVE.swap"
  [[ ! -e "$tmp" ]] || die "$tmp exists from an interrupted rollback; check it, then remove it"
  mv "$LIVE" "$tmp"
  mv "$PREV" "$LIVE"
  mv "$tmp" "$PREV"
}

rollback() {
  [[ -d "$PREV" ]] || die "no previous version at $PREV"
  exec 9>"$DEPLOY_LOCK"
  flock -n 9 || die "a bfep sync deploy is running"
  hold_run_lock
  say "Rolling back from $(version "$LIVE")"
  swap
  say "Now running $(version "$LIVE")"
}

show_log() {
  # Searching the whole journal took ~13 s on butterfly, so by default only
  # the last 24 hours are searched (a nightly run always falls inside that).
  local lines=50 since=-24h
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) since= ;;
      --since) [ $# -ge 2 ] || usage_error sync "--since needs a time, e.g. 3d, 12h or 2026-10-01"
               since="$2"; shift ;;
      --since=*) since="${1#--since=}" ;;
      -*) usage_error sync "unknown option for log: '$1'" "--all|bfep sync log --all" "--since|bfep sync log --since 3d" ;;
      [0-9]*[smhdw]) usage_error sync "not a number of lines: '$1'" "$1|bfep sync log --since $1" ;;
      *[!0-9]* | "") usage_error sync "not a number of lines: '$1'" ;;
      *) lines="$1" ;;
    esac
    shift
  done
  # "3d" and "12h" mean that long ago, as journalctl's "-3d" does.
  case "$since" in [0-9]*[smhdw]) since="-$since" ;; esac
  [ -t 1 ] && echo "Reading the sync log${since:+ since $since} (this can take a few seconds)..." >&2
  journalctl -u "$UNIT" -n "$lines" --no-pager -o cat ${since:+--since "$since"}
}

# status, test and rollback take no arguments.
no_args() { [[ $# -le 1 ]] || usage_error sync "$1 takes no arguments, got: ${*:2}"; }

case "${1:-}" in
  status) no_args "$@"; status ;;
  log) shift; show_log "$@" ;;
  test) no_args "$@"; cd "$LIVE" && exec "$PY" -m unittest discover -s tests ;;
  deploy) shift; deploy "$@" ;;
  rollback) no_args "$@"; rollback ;;
  -h | --help | help) show_help ;;
  -* | "") run "$@" ;;
  *=*) usage_error sync "settings go before the command, not after it: '$1'" "--dry-run|DRY_RUN=1 bfep sync deploy" ;;
  *) usage_error sync "unknown command '$1'" "${COMMAND_HINTS[@]}" ;;
esac
