# Copy to /etc/bfep-sync.env, then: chown root:root and chmod 600.
# systemd reads it as root before dropping to the service user.

# Database. Use the dedicated bfep_sync role from grants.sql, or whatever
# user the old sync script used.
PGHOST=localhost
PGPORT=5432
PGDATABASE=bfdb
PGUSER=bfep_sync
PGPASSWORD=change-me

# Which platforms to sync. gofundme is what the old script did.
SYNC_PROVIDERS=gofundme
# SYNC_PROVIDERS=gofundme,gogetfunding   # after a dry run looks right
# JUSTGIVING_APP_ID=

# How after-sync.sh calls drush (see that file).
BFEP_DRUSH=drush
