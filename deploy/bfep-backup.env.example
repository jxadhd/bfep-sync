# Copy to /etc/bfep-backup.env, then: chown root:root and chmod 600.
# "bfep backup" refuses to run if this file is readable by anyone but root.

# Cloudflare R2. Account ID is on the R2 overview page. Use an R2 API token
# with "Object Read & Write" on this one bucket only (not Admin).
R2_ACCOUNT_ID=
R2_BUCKET=bfep-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only for an EU-jurisdiction bucket:
# R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com

# Limits. These keep everything inside the free tier (10 GB-month storage,
# 1M Class A and 10M Class B requests a month). The code will not accept a
# storage limit above 9 GB or request limits above a tenth of the free ones.
BACKUP_MAX_GB=8            # whole-bucket total; old backups go first, else the upload is refused
BACKUP_MAX_OBJECT_GB=2     # refuse a single backup bigger than this
BACKUP_KEEP_DAYS=30        # delete backups older than this...
BACKUP_KEEP_MIN=7          # ...but always keep at least this many of the newest
BACKUP_MAX_CLASS_A=1000    # uploads and listings per month (a daily run uses ~60)
BACKUP_MAX_CLASS_B=1000    # downloads per month
BACKUP_PREFIX=db/

# Databases: one [section] per name in /etc/bfep-backup.pg_service.conf.
BACKUP_DATABASES="drupal bfdb"
PG_SERVICE_FILE=/etc/bfep-backup.pg_service.conf
PG_DUMP_IMAGE=postgres:18-alpine   # pg_dump must be at least the server's version

# Optional: encrypt each backup with gpg before it leaves the server. Keep a
# copy of the passphrase somewhere other than this server, or the backups
# cannot be read when you need them.
# BACKUP_PASSPHRASE_FILE=/etc/bfep-backup.passphrase

# Local copies kept on this server (the newest N).
BACKUP_LOCAL_DIR=/var/backups/bfep-db
BACKUP_LOCAL_KEEP=3
